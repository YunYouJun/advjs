{
  "name": "@advjs/studio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "ADV.JS Studio - visual novel editor app",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "vitest",
    "lint": "eslint .",
    "cap:init:ios": "cap add ios",
    "cap:init:android": "cap add android",
    "cap:assets": "capacitor-assets generate --iconBackgroundColor '#8b5cf6' --iconBackgroundColorDark '#1f1730' --splashBackgroundColor '#ffffff' --splashBackgroundColorDark '#0f0f17'",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:run:ios": "npm run build && cap sync ios && cap run ios",
    "cap:run:android": "npm run build && cap sync android && cap run android",
    "release:ios": "npm run build && cap sync ios && npm run cap:open:ios"
  },
  "dependencies": {
    "@advjs/client": "workspace:*",
    "@advjs/core": "workspace:*",
    "@advjs/gui": "workspace:*",
    "@advjs/parser": "workspace:*",
    "@advjs/plugin-interactions": "workspace:*",
    "@advjs/types": "workspace:*",
    "@advjs/unocss": "workspace:*",
    "@capacitor/app": "catalog:",
    "@capacitor/core": "catalog:",
    "@capacitor/filesystem": "catalog:",
    "@capacitor/haptics": "catalog:",
    "@capacitor/ios": "catalog:",
    "@capacitor/keyboard": "catalog:",
    "@capacitor/status-bar": "catalog:",
    "@ionic/vue": "catalog:",
    "@ionic/vue-router": "catalog:",
    "@mozilla/readability": "catalog:",
    "@tanstack/vue-virtual": "catalog:",
    "@vueuse/core": "catalog:frontend",
    "dexie": "catalog:",
    "diff": "catalog:",
    "ionicons": "catalog:",
    "jszip": "catalog:",
    "markdown-it": "catalog:build",
    "mermaid": "catalog:",
    "modern-screenshot": "catalog:frontend",
    "monaco-editor": "catalog:frontend",
    "pdfjs-dist": "catalog:",
    "pinia": "catalog:frontend",
    "qrcode": "catalog:",
    "reka-ui": "catalog:frontend",
    "splitpanes": "catalog:frontend",
    "vue": "catalog:frontend",
    "vue-i18n": "catalog:frontend",
    "vue-router": "catalog:frontend",
    "y-indexeddb": "catalog:",
    "y-monaco": "catalog:",
    "y-protocols": "catalog:",
    "yjs": "catalog:"
  },
  "devDependencies": {
    "@capacitor/assets": "catalog:",
    "@capacitor/cli": "catalog:",
    "@cloudbase/js-sdk": "catalog:",
    "@iconify-json/vscode-icons": "catalog:icons",
    "@playwright/test": "catalog:test",
    "@types/qrcode": "catalog:types",
    "@vitejs/plugin-legacy": "catalog:",
    "@vitejs/plugin-vue": "catalog:build",
    "@vue/test-utils": "catalog:test",
    "jsdom": "catalog:",
    "terser": "catalog:",
    "typescript": "catalog:dev",
    "unocss": "catalog:build",
    "unplugin-vue-components": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-pwa": "catalog:build",
    "vitest": "catalog:test",
    "vue-tsc": "catalog:dev"
  }
}
