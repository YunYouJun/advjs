<?xml version="1.0" encoding="UTF-8"?>
<!--
  Patch keys to merge into ios/App/App/Info.plist after `cap add ios`.

  These are ADDITIONS — the existing keys generated by Capacitor (CFBundleName,
  CFBundleVersion, UISupportedInterfaceOrientations, etc.) should stay as-is.

  TestFlight upload will fail if any required usage description is missing
  for an API the app calls, so update this list whenever you add a new
  permission-gated feature.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ===== Versioning ===== -->
    <!-- Marketing version shown in App Store; keep in sync with package.json -->
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <!-- Build number; bump every TestFlight upload -->
    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- ===== Display ===== -->
    <key>CFBundleDisplayName</key>
    <string>ADV.JS</string>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <!-- ===== Encryption export compliance ===== -->
    <!-- Studio only uses HTTPS calls to third-party AI APIs; no custom crypto.
         Setting this to false avoids the annual export-compliance form. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- ===== Usage descriptions ===== -->
    <!-- Photo library: cover image / character avatar picker -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>ADV.JS Studio needs access to your photo library so you can pick a cover image or character avatar for your project. Photos stay on your device and are never uploaded automatically.</string>
    <key>NSPhotoLibraryUsageDescription_zh</key>
    <string>ADV.JS Studio 需要访问相册,以便你为项目选择封面图或角色头像。所有图片仅保存在本机,不会自动上传。</string>

    <!-- Documents: Capacitor Filesystem reads/writes per-project folders -->
    <key>NSDocumentsFolderUsageDescription</key>
    <string>ADV.JS Studio stores your visual novel projects (chapters, characters, scenes) in the Documents folder so you can back them up or share them via Files.app.</string>

    <!-- ===== Status bar / appearance ===== -->
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>
    <key>UIUserInterfaceStyle</key>
    <string>Automatic</string>

    <!-- ===== Networking ===== -->
    <!-- Default ATS is fine — all AI providers we ship use HTTPS.
         Do NOT add NSAllowsArbitraryLoads. -->

    <!-- ===== File-handling capabilities ===== -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- ===== App categories ===== -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.entertainment</string>
</dict>
</plist>
