# Server only. Never use VITE_ names for credentials or copy this file into a project.
ADVJS_AUDIO_SERVICE_CONFIG=/etc/advjs/audio-service.json
OPENAI_API_KEY=
# A trusted credential broker atomically replaces <sha256([accountId,projectId])>.json
# under the configured stsDirectory, mode 0600, before its STS expiration.
# Each JSON has bucket, region, projectPrefix, TmpSecretId, TmpSecretKey,
# SecurityToken, StartTime and ExpiredTime. Long-term keys are not accepted.
# Qwen on an already-prepared darwin arm64 host uses the same config.mjs and CLI.
# Add qwen-tts to providers and register its pinned operator preset separately.
