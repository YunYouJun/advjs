{
  "name": "@advjs/desktop",
  "type": "module",
  "version": "0.1.5",
  "private": true,
  "description": "ADV.JS desktop creation client",
  "author": "YunYouJun",
  "license": "MPL-2.0",
  "main": "dist/main.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "icons:source": "node scripts/icons.mjs --refresh-source",
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "stage": "node scripts/stage.mjs",
    "package": "node scripts/run.mjs package",
    "make": "node scripts/run.mjs make",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "advjs": "workspace:*"
  },
  "devDependencies": {
    "@electron-forge/cli": "catalog:desktop",
    "@electron-forge/core": "catalog:desktop",
    "@electron-forge/maker-zip": "catalog:desktop",
    "@playwright/test": "catalog:test",
    "electron": "catalog:desktop",
    "sharp": "catalog:"
  }
}
