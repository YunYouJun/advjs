# SPIKE build outputs and generated Xcode files
spike/out/
spike/ios/StudioSpike.xcodeproj/
spike/ios/StudioSpike/Info.plist

# Engine build outputs (pnpm -C apps/studio-ios build:engine / golden)
engine/dist/
Packages/StudioKit/Sources/StudioKit/EngineBundle/*
!Packages/StudioKit/Sources/StudioKit/EngineBundle/.gitkeep
Packages/StudioKit/Tests/StudioKitTests/Golden/*
!Packages/StudioKit/Tests/StudioKitTests/Golden/.gitkeep

# Sample packages bundled into the App (pnpm -C apps/studio-ios build:samples)
StudioApp/Samples/

# Swift Package Manager and Xcode
.build/
/build/
.swiftpm/
xcuserdata/
DerivedData/

# Acceptance screenshots, recordings and test results stay out of the repository:
# keep them as UI-test attachments or CI artifacts.
# The same evidence/ and *.xcresult rules also live in the root .gitignore.
# These lines stay so this subtree is still covered on its own.
evidence/
*.xcresult
