{
  "name": "@advjs/core",
  "type": "module",
  "version": "0.1.2",
  "description": "Core library for AdvJS, providing essential functionalities and utilities.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunYouJun/advjs.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@advjs/assets": "workspace:0.1.2",
    "@advjs/parser": "workspace:0.1.2",
    "@advjs/types": "workspace:0.1.2",
    "@types/mdast": "catalog:types",
    "consola": "catalog:cli",
    "dayjs": "catalog:utils",
    "unstorage": "catalog:utils"
  },
  "devDependencies": {
    "unbuild": "catalog:build",
    "vue": "catalog:frontend"
  }
}
