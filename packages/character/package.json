    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@advjs/parser": "workspace:^0.1.3",
    "@advjs/types": "workspace:^0.1.3"
  },
  "devDependencies": {
    "unbuild": "catalog:build",
    "vitest": "catalog:test"
