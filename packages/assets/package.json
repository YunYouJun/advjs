{
  "name": "@advjs/assets",
  "type": "module",
  "version": "0.1.2",
  "description": "Platform-neutral asset catalog and authoring workflow primitives for ADV.JS.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunYouJun/advjs.git",
    "directory": "packages/assets"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@advjs/types": "workspace:0.1.2"
  },
  "devDependencies": {
    "unbuild": "catalog:build"
  }
}
