{
  "name": "@advjs/devtools",
  "type": "module",
  "version": "0.1.4",
  "description": "Devtools for ADV.JS",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs"
    },
    "./devframe": {
      "types": "./dist/devframe.d.ts",
      "import": "./dist/devframe.mjs"
    },
    "./*": "./*"
  },
  "module": "dist/vite.mjs",
  "types": "./dist/vite.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "unbuild && vite build",
    "dev": "unbuild --stub && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vite": "*"
  },
  "dependencies": {
    "@advjs/types": "workspace:0.1.4",
    "@devframes/service-shiki": "catalog:",
    "@devframes/vite": "catalog:",
    "consola": "catalog:cli",
    "devframe": "catalog:",
    "hookable": "catalog:utils",
    "pathe": "catalog:utils",
    "shiki": "catalog:"
  },
  "devDependencies": {
    "@advjs/gui": "workspace:0.1.4",
    "@vitejs/plugin-vue": "catalog:build",
    "sass": "catalog:build",
    "typescript": "catalog:dev",
    "unbuild": "catalog:build",
    "vite": "catalog:build",
    "vue": "catalog:frontend",
    "vue-tsc": "catalog:dev"
  }
}
