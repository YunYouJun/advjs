{
  "name": "@advjs/plugin-template",
  "type": "module",
  "version": "0.0.1",
  "description": "Template Plugin for ADV.JS",
  "author": {
    "name": "YunYouJun",
    "email": "me@yunyoujun.cn",
    "url": "https://www.yunyoujun.cn"
  },
  "license": "MPL-2.0",
  "exports": {
    ".": "./dist/index.mjs",
    "./*": "./*"
  },
  "main": "dist/index.mjs",
