{
  "name": "@advjs/ai",
  "type": "module",
  "version": "0.1.1",
  "description": "AI for ADV.JS: a browser-safe chat client and story session, plus Node workflows under @advjs/ai/node",
  "author": {
    "name": "YunYouJun"
  },
  "license": "MPL-2.0",
  "homepage": "https://github.com/YunYouJun/advjs/tree/main/packages/ai#readme",
  "keywords": [
    "advjs",
    "ai",
    "openai",
    "hunyuan"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "dev": "unbuild --stub",
    "build": "unbuild",
    "gen": "tsx scripts/gen.ts",
    "gen:img": "tsx scripts/gen-img.ts",
    "schema": "tsx scripts/schema.ts",
    "workflow": "tsx scripts/run-workflow.ts"
  },
  "dependencies": {
    "@advjs/types": "workspace:*",
    "consola": "catalog:cli",
    "dotenv": "catalog:cli",
    "openai": "catalog:ai",
    "tencentcloud-sdk-nodejs-hunyuan": "catalog:"
  },
  "devDependencies": {
    "tsx": "catalog:dev",
    "unbuild": "catalog:build"
  }
}
