{
  "name": "@advjs/theme-default",
  "type": "module",
  "version": "0.1.2",
  "description": "Default Theme for ADV.JS",
  "author": {
    "name": "YunYouJun",
    "email": "me@yunyoujun.cn",
    "url": "https://www.yunyoujun.cn"
  },
  "license": "MPL-2.0",
  "keywords": [
    "advjs-theme",
    "advjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.ts",
    "./*": "./*"
  },
  "main": "index.ts",
  "files": [
    "assets",
    "client",
    "components",
    "composables",
    "index.ts",
    "layouts",
    "node",
    "pages",
    "stores",
    "styles",
    "types",
    "uno.config.ts"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "advjs": ">=0.0.1"
  },
  "advjs": {
    "colorSchema": "both"
  },
  "dependencies": {
    "@iconify-json/ri": "catalog:icons"
  },
  "devDependencies": {
    "@advjs/core": "workspace:0.1.2",
    "advjs": "workspace:0.1.2"
  }
}
